# -----------------------------------------------------------------------------
# Student Attendance Tracker - Environment Configuration Template
# Copy this file to '.env' for local testing, or configure these variables in
# your Vercel Project Dashboard (Settings > Environment Variables).
# -----------------------------------------------------------------------------

# Flask Secret Key for session signing & CSRF protection
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-random-secret-key-here-min-32-chars

# Production PostgreSQL Database URL (Neon, Supabase, Vercel Postgres, or RDS)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
# If left empty, the application automatically defaults to local SQLite (attendance_tracker.db)
DATABASE_URL=postgresql://attendance_user:your_db_password@ep-sample-project-123456.us-east-2.aws.neon.tech/attendance_db?sslmode=require

# Optional alternative variable name supported by Vercel Postgres / Neon
# POSTGRES_URL=postgresql://attendance_user:your_db_password@ep-sample-project-123456.us-east-2.aws.neon.tech/attendance_db?sslmode=require

# Local development port (optional, default: 5000)
PORT=5000
